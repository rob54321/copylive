#!/bin/bash
# this script builds an ubuntu live system with macrium reflect and microsoft media creattion tool
# on a bootable usb disk. The grub menu is used.
# all macrium and microsoft media creation files are to found in /mnt/debhome/livesystem/MACRIUM and MCTREC resp.
# options for this script are
# -p partition disk
# -E size of EFILIVE partiton, default is 1GB -- for partdisk.pl
# -L size of linuxlive parition, default is 8GB   -- for partdisk.pl
# -W size of writable partition, default is 10GB  -- for partdisk.pl
# -M size of MACRIUM partition, default is 2GB     -- for partdisk.pl
# -T size of MCTREC partition, default is 8GB
# -i iso image to use
# -h a help message

# the rc code is passed as first parameter, no exit on 0, exit on 1, 2, 3..
# second parameter is the error string
# optional: third parameter is the device to un mounted if there is one.
exitonerror() {
	# test rc code
	if test $1 -ne 0; then
		# display error string
		echo "$2"

		# check if $3 is a device to umount
		if test "$3" != ""; then
			findmnt "$3"
			test "$?" -eq 0 && umount -v "$3"
		fi
		exit 1
	fi
}

#############################################################################
# getdevice gets the device that LINUXLIVE is on.
# this function returns the device of form /dev/sda
# or none if device was not found.
# the device or none is captured by the calling
# function
# parameters passed: none
#############################################################################
getdevice () {
	# call a perl function to get the LINUXLIVE device
	# LINUXLIVE partition could be 1 (vfat) or 2 (ext4)
	DEVICE=$(perl -e 'use strict; use warnings; do {
										# get all devices
										my @list = `lsblk -o PATH,LABEL`;
										chomp(@list);
										# for each item in list
										foreach my $line (@list) {
											# if line contains LINUXLIVE get device path
											if ($line =~ /LINUXLIVE/) {
												# line = /dev/sda3    label
												# search for partition name first
												# remove white space to end of line
												$line =~ s/\s+.*$//;
												# line is of form /dev/sda12
												# remove digits to end of line
												$line =~ s/\d+.*$//;
												# print the value
												# so it is captured by DEVICE
												print "$line";
												# exit the loop
												last;
											}
										}
									}')
	# if the device was found echo value
	# else echo none
	if test "${DEVICE}" != ""; then
		echo "${DEVICE}"
	else
		echo "none"
	fi
}

##########################################################################################
# function to umount LABEL = $1 on /mnt/LABEL
# checks for multiple mounts on multiple mountpoints first.
# unmounts all erroneous mounts
# exits on error if any error occurs
# parameters passed: LABEL
##########################################################################################
umountlabel () {
	# get the path of the LINUXLIVE, MACRIUM, MCTREC, writable
	# all are on the same device.
	DEVICE=`getdevice`

	# set the partition number to be un mounted

	# the partitions are numbered as follows:
	# p 1 EFILIVE
	# p 2 LINUXLIVE
	# p 3 writable
	# p 4 MACRIUM
	# p 5 MCTREC
	# p 6 ele
	# all are on the same device
	case $1 in
		EFILIVE)   p=1;;
		LINUXLIVE) p=2;;
		writable)  p=3;;
		MACRIUM)   p=4;;
		MCTREC)    p=5;;
		ele)       p=6;;
		*)         exitonerror 1 "Unknown option for umountlabel(): $1";;
	esac
	PARTITION="${DEVICE}${p}"

	# get a list of mount points for the partition
	# unmount all of them,
	# the bash parameters are partition_no and true/null for verbose/quiet
	RESULT=$(perl -e 'use strict; use warnings;
				my $partition = shift;
				my $verbose = shift;
				my @list = `findmnt -o TARGET $partition`;
				chomp(@list);
				for (my $i=1; $i<scalar(@list); $i++) {
					# umount all
					if ($verbose eq "true") {
						system("umount -v $list[$i]");
					} else {
						system("umount $list[$i]");
					}
				}' "${PARTITION}" "${VERBOSE}";)
	echo "${RESULT}";
}

#############################################################################################
# function to copy initialise-linux from local repository to /mnt/writable/upper/root
# no parameters are passed
# /mnt/debhome must be accessible.
#############################################################################################
copyinitialise() {
	# copy initialise-linux package to /mnt/writable/upper/root/
	# check if /mnt/writable exists
	test -d /mnt/writable || sudo -u robert mkdir ${VERBOSE:+"-v"} /mnt/writable

	# check writable is not mounted elswhere
	umountlabel "writable"
	# mount writable and copy initialise-linux
	mount ${VERBOSE:+"-v"} -L writable /mnt/writable
	exitonerror $? "Could not mount /mnt/writable" "/mnt/writable"
	mkdir ${VERBOSE:+"-v"} -p /mnt/writable/upper/root/
	exitonerror $? "Could not make directory /mnt/writable/upper/root" "/mnt/writable"
	cp ${VERBOSE:+"-v"} /mnt/debhome/pool/myown/i/initialise-linux/*.deb /mnt/writable/upper/root/
	exitonerror $? "Could not copy initialise-linux to /mnt/writable/upper/root/" "/mnt/writable"
	umount ${VERBOSE:+"-v"} /mnt/writable
	exitonerror $? "Could not umount /mnt/writable"
}

#########################################################################
# function to determine if first partition is EFILIVE or LINUXLIVE
# and determine uuid for the copy
# parameters passed: device . 1 ie /dev/sda1 for example
#########################################################################
partition1name() {
	# much  easier in perl
	# is partition 1 EFILIVE or LINUXLIVE
	PARTNAME=$(perl -e 'use strict; use warnings;
					  my $part = shift;
	                  my @list = `lsblk $part -o LABEL,UUID`;
	                  # 1st line is LABEL title
	                  # 2nd line is actual label
	                  print "$list[1]";' "$1")
#	echo "${PARTNAME}"
}
	                  

#########################################################################
# function to install grub
# parameters passed: copy or nothing
# if copy is passed then cdrom is copied to LINUXLIVE
#########################################################################
installgrub () {
	# if copy given as first parameter
	# get device for grub install
	DEVICE=`getdevice`
	test "${DEVICE}" = "none" && exitonerror 1 "LINUXLIVE device could not be found: could not install grub"

	# the device may be p1 LINUXLIVE vfat...
	# or                p1 EFILIVE ; p2 LINUXLIVE ...
	if test "$1" = "copy"; then
		# copy initialise-linux from local repository to /mnt/writable/upper/root/
		copyinitialise

		# determine if p1 is EFILIVE or LINUXLIVE
		partition1name "${DEVICE}1"
		echo "partition name is : ${PARTNAME}"
		if test "${PARNAME}" = "LINUXLIVE"; then
			# copy all files
			copyfiles "/root/cdrom" "LINUXLIVE"

			# get distro name from /mnt/cdrom/.disk/info
			DISTRONAME=`getdistroname`;

			# echo distro name
			echo "distro name: ${DISTRONAME}"

			# copy grub.cfg to /root/cdrom/boot/grub.cfg
			# set the uuid of the boot partition on the live system by reading it from the partition
			# uuid is different for vfat and ext4 LINUXLIVE partition.
			copygrub "${DISTRONAME}" "${UUID}"

		elif test "$PARTNAME}" = "EFILIVE"; then
			#cdrom/EFI and cdrom/boot must be moved to /mnt/EFILIVE
			umountlabel "EFILIVE"
			mount ${VERBOSE:+"-v"} -L EFILIVE /mnt/EFILIVE
			exitonerror $? "Error could not mount /mnt/EFILIVE" "/mnt/EFILIVE"

			# delete all links
			find "/root/EFILIVE" -type l -exec rm ${VERBOSE:+"-v"} {} \;

			# mv EFI and boot from cdrom in root
			mv ${VERBOSE:+"-v"} /root/cdrom/EFI /mnt/EFILIVE
			exitonerror $? "Error moving EFI to /mnt/EFILIVE"
			mv ${VERBOSE:+"-V"} /root/cdrom/boot /mnt/EFILIVE
			exitonerror $? "Error moving boot to /mnt/EFILIEVE"
			
			#umount EFILIVE
			umountlabel "EFILIVE"
			
			# copy the rest of the /root/cdrom
			copyfiles "/root/cdrom" "linuxlive"
		fi
	fi

	# the LINUXLIVE DEVICE was found
	# install grub
	# TESTING
	echo "install-grub ${VERBOSE:+"-v"} on ${DEVICE}"
	
	# only install grub on amd64
	ARCH=`arch`
	if test "${ARCH}" = "x86_64"; then
		grub-install --uefi-secure-boot --no-floppy --removable --target=x86_64-efi "${DEVICE}"
		exitonerror $? "Error installing grub"
	else
		echo "Simulating grub-install on arm64"
	fi
}


################################################################
# function to get distro name from cdrom/.disk/info
# the name is used for grub.cfg
# parameters passed: none
# the global variable DISTRONAME is set
################################################################
getdistroname () {
	# get the long name
	# Ubuntu-Cinnamon 26.04 "Resolute Raccoon" - Release amd64 (20260423.1)
	# strip from ' - Release ...to end
	# replace each " with \"
	LIST=`cat /root/cdrom/.disk/info`;
	DISTRONAME=$(perl -e 'my $name = shift; $name =~ s/ - .*$//;
							$name =~ s/"//g;
							chomp($name);
							print "$name";' "${LIST}");

	echo "${DISTRONAME}"
}

# function to copy grub.cfg to /root/cdrom/boot/grub/grub.cfg
# parameters passed: 1 Flavour name version "Distro Name"
#                    2 UUID of boot partition on the live system
# name is obtained from cdrom/.disk/info
# this function works for both LINUXLIVE or EFILIVE
copygrub() {
	# backup original grub
	# if -e ext4 chosen boot and EFI directories will be moved to /mnt/EFILIVE
	mv ${VERBOSE:+"-v"} /root/cdrom/boot/grub/grub.cfg /root/cdrom/boot/grub/grub.cfg.original
	exitonerror $? "Error moving grub.cfg to grub.cfg.original"

	# create /root/cdrom/boot/grub/grub.cfg
echo "set timeout=30

loadfont unicode

set menu_color_normal=white/blue
set menu_color_highlight=red/white

menuentry \"Try $1\" {
    set gfxpayload=keep

	insmod part_gpt
	insmod fat
	insmod ext2
	search --no-floppy --fs-uuid --set=root $2

    linux  /casper/vmlinuz  --- username=robert hostname=live persistent persistent-path=/casper/ noprompt vt.cur_default=8
    initrd /casper/initrd
}
menuentry \"$1 (safe graphics)\" {
    set gfxpayload=keep

	insmod part_gpt
	insmod fat
	insmod ext2
	search --no-floppy --fs-uuid --set=root $2
    linux  /casper/vmlinuz nomodeset  --- quiet splash
    initrd /casper/initrd
}
menuentry \"Macrium Reflect rescue \" {
	insmod part_gpt
	insmod fat
	if [ x\$feature_platform_search_hint = xy ]; then
	  search --no-floppy --fs-uuid --set=root  AED6-434E
	else
	  search --no-floppy --fs-uuid --set=root AED6-434E
	fi
	chainloader /bootmgfw.efi
	#chainloader /EFI/Boot/bootx64.efi
}
menuentry \"Windows Media Creation Tool Recovery (Read the instructions on the next screen)\" {
	echo \"You can use shift F10 for an administrator console\"
	echo \"install.esd is in sources directory\"
	echo \"You can hit escape to exit this message\"
	sleep -v -i 60

	insmod part_gpt
	insmod fat
	if [ x\$feature_platform_search_hint = xy ]; then
	  search --no-floppy --fs-uuid --set=root  4444-4444
	else
	  search --no-floppy --fs-uuid --set=root 4444-4444
	fi
	chainloader /bootmgfw.efi
}

grub_platform
if [ \"\$grub_platform\" = \"efi\" ]; then
menuentry 'Boot from next volume' {
    exit 1
}
menuentry 'UEFI Firmware Settings' {
    fwsetup
}
fi" > /root/cdrom/boot/grub/grub.cfg
}

##################################################################################
# function to copy MCTREC, MACRIUM and
# LINUXLIVE files to the hard disk. Partitions are mounted
# and unmounted.
# parameters passed 1. full source path
#                   2. LABEL of partition
##################################################################################
copyfiles () {
	# umounts device
	# mounts device
	# if /mnt/$2 contains files remove all files first
	# if $2 is LINUXLIVE also prompt to remove files from writable
	# copies files from $1 -> /mnt/$2
	# exits on any errors
	#
	# parameters passed:
	# 1 full source path
	# 2 label MACRIUM or MCTREC or LINUXLIVE/EFILIVE for file type

	# make the mount directory if it does not exist
	test -d "/mnt/$2" || sudo -u "robert" mkdir ${VERBOSE:+"-v"} "/mnt/$2"

	# mount LABEL if not already mounted
	umountlabel "$2"
	mount ${VERBOSE:+"-v"} -L "$2" "/mnt/$2"
	exitonerror "$?" "copyfiles: Could not mount $2 on /mnt/$2" "/mnt/$2"

	# links cannot be copied to a fat32 filesystem
	# delete all links
	find "$1" -type l -exec rm ${VERBOSE:+"-v"} {} \;

	# cp -dR -T /mnt/debhome/livesystem/MACRIUM /mnt/LINUXLIVE/
	echo "copying $1 -> /mnt/$2"


	cp -dR -T ${EXTRAVERBOSE:+"-v"} "$1" "/mnt/$2"
	exitonerror $? "Could not copy $1 files to /mnt/$2" "/mnt/$2"
	# umount device which must be in fstab
	umountlabel "$2"
}

##################################################################
# function to mount cdrom, copy files
# to /root/cdrom and set the file permissions
# so that cp -T can be used for each partition
# parameters passed: isoimage name
##################################################################
mountcopypermissions() {
	# make /mnt/cdrom if it does not exist
	test -d /mnt/cdrom || mkdir /mnt/cdrom

	# mount the cdrom
	# umount it first if mounted
	# since the wrong one may be mounted
	findmnt /mnt/cdrom > /dev/null 2>&1
	if test "$?" -eq 0; then
		umount ${VERBOSE:+"-v"} "/mnt/cdrom"
		exitonerror $? "Error umounting $1"
	fi

	# mount the cdrom
	mount ${VERBOSE:+"-v"} "$1" /mnt/cdrom -o ro
	exitonerror $? "Could not mount $1 on /mnt/cdrom" "/mnt/cdrom"

	# if /root/cdrom exists
	# delete it
	test -d /root/cdrom && rm ${EXTRAVERBOSE:+"-v"} -rf /root/cdrom

	# copy cdrom files to root
	echo "copying /mnt/cdrom -> /root"
	cp -dR ${EXTRAVERBOSE:+"-v"} /mnt/cdrom /root/
	exitonerror $? "Error copying files from /mnt/cdrom to /root/cdrom" "/mnt/cdrom"
	# set file and directory permissions
	find /root/cdrom -type f -exec chmod a+w {} \;
	find /root/cdrom -type d -exec chmod 755 {} \;

	umount ${VERBOSE:+"-v"} "/mnt/cdrom"
	exitonerror $? "Could not umount iso image $1 from /mnt/cdrom"
}

# usage function
usage() {
	echo "-c isoimage : create /root/cdrom with iso image";
	echo "-i install grub and copy cdrom files to LINUXLIVE and copy initialise-linux to /mnt/writable/upper/root/"
	echo "-I install grub only"
	echo "-U uuid / volume id of LINUXLIVE partition"
	echo "	ext4 default ${LINUXLIVEUUID}"
	echo "	vfat default ${LINUXLIVEVOLID}"
	echo "-m copy MACRIUM files to MACRIUM partition";
	echo "-t copy MCTREC files to MCTREC partition";
	echo "-e partition disk LINUXLIVE as ext4, separate from EFI partition";
	echo "-f partition disk LINUXLIVE as fat32. combined with EFI parttion";
	echo "-E size in GB of EFILIVE partition, default = ${EFISIZE}GB";
	echo "-M size in GB of MACRIUM parition, default = ${MASIZE}GB";
	echo "-L size in GB of LINUXLIVE partition, default = ${LLIVESIZE}GB";
	echo "-W size in GB of writable partition, default = ${WSIZE}GB";
	echo "-T size in GB of MCTREC partition, default = ${MCTSIZE}GB";
	echo "-v verbose for everything except file copy/move"
	echo "-V verbose for everything"
	exit 0;
}

#################################################################
# main entry
#################################################################

# set partition disk to false, unless -p or -D or -W or -M passed
PARTDISK="false"
# default values for partdisk.pl in GB
EFISIZE=2;
LLIVESIZE=8;
WSIZE=10;
MCTSIZE=8;
MASIZE=2;
# default values for switches
ISOIMAGE="none"
CPMACRIUM="false"
CPMCTREC="false"
INSTALLGRUB="false"
INSTALLGRUBCOPY="false"
VFATOPTION="false"
EXT4OPTION="false"
UUID="0"

# VERBOSE must not be set for absence of -v
# if it is set to anything, -v will be used
VERBOSE=
# EXTRAVERBOSE is used to display verbose for copying of files as well"
EXTRAVERBOSE=

# uuid of LINUXLIVE parition p2.
LINUXLIVEUUID="12345678-1234-1234-1234-123456789012"

#volume id for LINUXLIVE partition p1
LINUXLIVEVOLID="11111111"

# source path for MACRIUM and MCTREC files.
MSOURCE="/mnt/debhome/livesystem"

while getopts efiU:Ic:D:W:M:L:T:mtvVh opt
do
	case ${opt} in
		f) VFATOPTION="true"; PARTDISK="true";;
		e) EXT4OPTION="true"; PARTDISK="true";;
		I) INSTALLGRUB="true";;
		U) UUID="${OPTARG}"; PARTDISK="true";;
		E) EFISIZE="${OPTARG}";;
		i) INSTALLGRUBCOPY="true";;
		c) ISOIMAGE="${OPTARG}";;
		M) MASIZE="${OPTARG}"; PARTDISK="true";;
		L) LLIVESIZE="${OPTARG}"; PARTDISK="true";;
		W) WSIZE="${OPTARG}"; PARTDISK="true";;
		T) MCTSIZE="${OPTARG}"; PARTDISK="true";;
		m) CPMACRIUM="true";;
		t) CPMCTREC="true";;
		v) VERBOSE="true";;
		V) EXTRAVERBOSE="true"; VERBOSE="true";;
		h) usage;;
		\?) usage;;
	esac
done

# testing
# echo "${ISOIMAGE}: ${PARTDISK}, ${LLIVESIZE}, ${WSIZE} , ${MCTSIZE}";

# if -p or -D or -W or -M or -e or -f given , partition the disk
# for partitioning one of -e or -f must be given.
if test "${PARTDISK}" = "true"; then
	# check if -e given
	if test "${EXT4OPTION}" = "true"; then
		# partition with ext4 option
		# set the uuid to default if it was not given
		test "${UUID}" = "0" && UUID="${LINUXLIVEUUID}"

		/usr/local/bin/partdisk.pl ${VERBOSE:+"-v"} -e -E "${EFISIZE}" -U "${UUID}" -L "${LLIVESIZE}" -W "${WSIZE}" -M "${MASIZE}" -T "${MCTSIZE}"
		exitonerror $? "partdisk.pl gave an error ... exiting"
	elif test "${VFATOPTION}" = "true"; then
		# parition with vfat option
		# set the uuid to default if it was not given
		test "${UUID}" = "0" && UUID="${LINUXLIVEVOLID}"

		/usr/local/bin/partdisk.pl ${VERBOSE:+"-v"} -f -U "${UUID}" -L "${LLIVESIZE}" -W "${WSIZE}" -M "${MASIZE}" -T "${MCTSIZE}"
		exitonerror $? "partdisk.pl gave an error ... exiting"
	else
		# neither -e nor -f was given
		echo "Neither -e nor -f was given: cannot partition the disk"
	fi
fi

# if -c given, create /root/cdrom else /root/cdrom must already exist
if test "${ISOIMAGE}" != "none"; then
	# check iso image exists
	test -f "${ISOIMAGE}" || exitonerror 1 "${ISOIMAGE}: no such file";

	# mount the cdrom for coyping files to /root/cdrom
	# check if /root/cdrom exists
	# mount , copy, set permissions
	mountcopypermissions "${ISOIMAGE}"

fi

# copy files for MACRIUM if -m given
test "${CPMACRIUM}" = "true" && copyfiles "${MSOURCE}/MACRIUM" "MACRIUM"

# for mctrec if -t given
test "${CPMCTREC}" = "true" && copyfiles "${MSOURCE}/MCTREC" "MCTREC"

# install grub to the correct device
# -i install and copies cdrom  EFI files
# -I install grub only
# -i takes precedence over -I
# device is in /root/.device which was written by partdisk.pl
# get the device, if device not found, none is returned
if test "${INSTALLGRUBCOPY}" = "true"; then
	installgrub "copy"
elif test "${INSTALLGRUB}" = "true"; then
	# -I given, install grub only
	installgrub
fi
