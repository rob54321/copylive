#!/bin/bash
# this script builds an ubuntu live system with macrium reflect and microsoft media creattion tool
# on a bootable usb disk. The grub menu is used.
# all macrium and microsoft media creation files are to found in /mnt/debhome/livesystem/MACRIUM and MCTREC resp.
# options for this script are
# -p partition disk
# -D size of linuxlive parition, default is 8GB   -- for partdisk.pl
# -W size of writable partition, default is 10GB  -- for partdisk.pl
# -M size of MCTREC partition, default is 8GB     -- for partdisk.pl
# -i iso image to use
# -h a help message

# the rc code is passed as first parameter, no exit on 0, exit on 1, 2, 3..
# second parameter is the error string
exitonerror() {
	# test rc code
	if test $1 -ne 0; then
		# display error string
		echo "$2"
		exit 1;
	fi
}


# usage function
usage() {
	echo "-i iso image path to use";
	echo "-p partition disk with default parameters";
	echo "-D size in GB of LINUXLIVE partition, default = 8GB";
	echo "-W size in GB of writable partition, default = 10GB";
	echo "-M size in GB of MCTREC partition, default = 8GB";
	exit 0;
}

#################################################################
# main entry
#################################################################

# set partition disk to false, unless -p or -D or -W or -M passed
PARTDISK="false"
# default values for partdisk.pl in GB
LLIVESIZE=8;
WSIZE=10;
MCTSIZE=8;

while getopts i:pD:W:M:h opt
do
	case ${opt} in
		i) ISOIMAGE="${OPTARG}";;
		p) PARTDISK="true";;
		D) LLIVESIZE="${OPTARG}"; PARTDISK="true";;
		W) WSIZE="${OPTARG}"; PARTDISK="true";;
		M) MCTSIZE="${OPTARG}"; PARTDISK="true";;
		h) usage;;
		\?) usage;;
	esac
done

# testing
# echo "${ISOIMAGE}: ${PARTDISK}, ${LLIVESIZE}, ${WSIZE} , ${MCTSIZE}";

# check iso image exists
test -f "${ISOIMAGE}" || exitonerror 1 "${ISOIMAGE}: no such file";

# if -p or -D or -W or -M given , partition the disk
if test "${PARTDISK}" = "true"; then
	/usr/local/bin/partdisk.pl -D "${LLIVESIZE}" -W "${WSIZE}" -M "${MCTSIZE}"
	exitonerror $? "partdisk.pl gave an error ... exiting"
fi

# mount the cdrom
# make the directory if necessary
if test ! -d /mnt/cdrom; then
	mkdir /mnt/cdrom
	exitonerror $? "Could not make directory /mnt/cdrom"
fi

mount "${ISOIMAGE}" /mnt/cdrom -o ro
exitonerror $? "Could not mount ${ISOIMAGE} on /mnt/cdrom"

# rem
