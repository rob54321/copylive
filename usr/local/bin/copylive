#!/bin/bash
# this script builds an ubuntu live system with macrium reflect and microsoft media creattion tool
# on a bootable usb disk. The grub menu is used.
# all macrium and microsoft media creation files are to found in /mnt/debhome/livesystem/MACRIUM and MCTREC resp.
# options for this script are
# -p partition disk
# -E size of EFILIVE partiton, default is 1GB -- for partdisk.pl
# -L size of linuxlive parition, default is 8GB   -- for partdisk.pl
# -W size of writable partition, default is 10GB  -- for partdisk.pl
# -M size of MACRIUM partition, default is 2GB     -- for partdisk.pl
# -T size of MCTREC partition, default is 8GB
# -i iso image to use
# -h a help message

# the rc code is passed as first parameter, no exit on 0, exit on 1, 2, 3..
# second parameter is the error string
# optional: third parameter is the device to un mounted if there is one.
exitonerror() {
	# test rc code
	if test $1 -ne 0; then
		# display error string
		echo "$2"

		# check if $3 is a device to umount
		if test "$3" != ""; then
			findmnt "$3"
			test "$?" -eq 0 && umount -v "$3"
		fi
		exit 1
	fi
}

#############################################################################
# getdevice gets the device that LINUXLIVE is on.
# this function returns the device of form /dev/sda
# or none if device was not found.
# the device or none is captured by the calling
# function
# parameters passed: none
#############################################################################
getdevice () {
	# call a perl function to get the LINUXLIVE device
	# LINUXLIVE partition could be 1 (vfat) or 2 (ext4)
	DEVICE=$(perl -e 'use strict; use warnings; do {
										my $device = "none";
										# get all devices
										my @list = `lsblk -o PATH,LABEL`;
										chomp(@list);
										# for each item in list
										OUTER: foreach my $line (@list) {
											# if line contains LINUXLIVE get device path
											if ($line =~ /LINUXLIVE/) {
												# line = /dev/sda3    label
												# search for partition name first
												# remove white space to end of line
												$line =~ s/\s+.*$//;
												# line is of form /dev/sda12
												# remove digits to end of line
												$line =~ s/\d+.*$//;
												# print the value
												# so it is captured by DEVICE
												$device = $line;
												# exit the loop

												last OUTER;
											}
										}
										# check if device found
										if ($device eq "none") {
											print "error: LINUXLIVE not found";
										} else {
											print "$device";
										}
									}')
	# if the device was found echo value and return 0
	# else return 1
	echo "${DEVICE}"
	if test "${DEVICE}" != "error"; then
		return 0
	else
		return 10
	fi
}

##########################################################################################
# function to get the partition number from the file system LABEL
# parameters passed: DEVICE, LABEL
# set PARTN
##########################################################################################
getpnofromlabel() {
	PARTN=$(perl -e 'use strict; use warnings;
					my $device = shift;
					my $label = shift;
					my $partno = 0;
					my @list = `lsblk $device -o LABEL,PARTN -n`;
					chomp(@list);
					# search for the label
					OUTER: for(my $i=1; $i<scalar(@list); $i++) {
						# get label and partition number from element
						$list[$i] =~ /(\w+)\s+(\d+)/;
						# check if label found
						if ($label eq $1) {
							# return partition no
							$partno = $2;
							last OUTER;
						}
					}
					print "$partno";' "$1" "$2" )
	# check if partition no found
	# if partition no = 0 not found
	echo "${PARTN}"
	if test "${PARTN}" -eq 0; then
		# not found
		return 10
	else
		# found
		return 0
	fi
}
##########################################################################################
# function to umount LABEL = $1 on /mnt/LABEL
# checks for multiple mounts on multiple mountpoints first.
# unmounts all erroneous mounts
# exits on error if any error occurs
# parameters passed: LABEL
##########################################################################################
umountlabel () {
	# get the path of the LINUXLIVE, MACRIUM, MCTREC, writable
	# all are on the same device.
	DEVICE=$(getdevice)
	# check for errors
	exitonerror "$?" "umountlabel: getdevice returned ${DEVICE} : could not find ${1}"
	echo "${VERBOSE:+"umountlabel: label = ${1} ; device = ${DEVICE}"}"

	# set the partition number to be un mounted

	# the partitions are numbered as follows:
	# p 1 EFILIVE / LINUXLIVE
	# p 2 LINUXLIVE
	# p 3 writable
	# p 4 MACRIUM
	# p 5 MCTREC
	# p 6 ele
	# all are on the same device

	# get partition number from the device and LABEL
	echo "${EXTRAVERBOSE:+"calling getpnofromlabel: ${DEVICE} "$1"" } "
	PARTNO=$(getpnofromlabel "${DEVICE}" "$1")
	
	# check for return of error
	exitonerror "$?" "getpnofromlabel: returned partition no = ${PARTNO}"
	
	echo "${EXTRAVERBOSE:+"getpnofromlabel: device;partno: ${DEVICE} ${PARTNO}"}"

	echo "${EXTRAVERBOSE:+"umountlabel: unmounting ${DEVICE}${PARTNO}"}" 
	PARTITION="${DEVICE}${PARTNO}"

	# get a list of mount points for the partition
	# unmount all of them,
	# the bash parameters are partition_no and true/null for verbose/quiet
	RESULT=$(perl -e 'use strict; use warnings;
				my $partition = shift;
				my $verbose = shift;
				my @list = `findmnt -o TARGET $partition`;
				chomp(@list);
				for (my $i=1; $i<scalar(@list); $i++) {
					# umount all
					if ($verbose eq "true") {
						system("umount -v $list[$i]");
					} else {
						system("umount $list[$i]");
					}
				}' "${PARTITION}" "${VERBOSE}";)
}

#############################################################################################
# function to copy initialise-linux from local repository to /mnt/writable/upper/root
# no parameters are passed
# /mnt/debhome must be accessible.
#############################################################################################
copyinitialise() {
	# copy initialise-linux package to /mnt/writable/upper/root/
	# check if /mnt/writable exists
	test -d /mnt/writable || sudo -u robert mkdir ${VERBOSE:+"-v"} /mnt/writable

	# check writable is not mounted elswhere
	umountlabel "writable"
	# mount writable and copy initialise-linux
	mount ${VERBOSE:+"-v"} -L writable /mnt/writable
	exitonerror $? "coypinitialise(): Could not mount /mnt/writable" "/mnt/writable"
	mkdir ${VERBOSE:+"-v"} -p /mnt/writable/upper/root/
	exitonerror $? "copyinitialise(): Could not make directory /mnt/writable/upper/root" "/mnt/writable"
	cp ${VERBOSE:+"-v"} /mnt/debhome/pool/myown/i/initialise-linux/*.deb /mnt/writable/upper/root/
	exitonerror $? "copyinitialise(): Could not copy initialise-linux to /mnt/writable/upper/root/" "/mnt/writable"
	umount ${VERBOSE:+"-v"} /mnt/writable
	exitonerror $? "copyinitialise(): Could not umount /mnt/writable"
}

#########################################################################
# function to find partition no and uuid of LINUXLIVE partition, (1 or 2) and return
# the uuid for ext4 must have the dashes
# the uuid for vfat must not have any dashes
# if LINUXLIVE is partition 1 , vfat then efi is in LINUXLIVE
# if LINUXLIVE is partition 2 , ext4 then efi is on partition 1
# parameters passed: device ie /dev/sda for example
# parameter returned : partition number 1 or 2; uuid of partition
# and a return code 0 or 10
#########################################################################
linuxlivedata() {
	# much  easier in perl
	# is partition 1 EFILIVE or LINUXLIVE
	PARTNOUUID=$(perl -e 'use strict; use warnings;
					  my $device = shift;
					  # partno 0 indicates no was not found
					  # non zero means partition no
					  my $partno = 0;
					  my $partname;
					  my $uuid = 0;

	                  my @list = `lsblk $device -n -o PARTN,LABEL,UUID 2>/dev/null`;
	                  # output format is:
	                  # part_no part_name fs-uuid
	                  chomp(@list);
	                  # search for LINUXLIVE in list
	                  for(my $i=1; $i<scalar(@list); $i++) {
						  # find partition name in output
						  # output = part_no  part_name     uuid
						  $list[$i] =~ /(\d+)\s+(\w+)\s+([a-zA-Z0-9-]+)/;
						  $partname = $2;
						  if ($2 eq "LINUXLIVE") {
							  # found LINUXLIVE indicate found and leave loop
							  $partno = $1;
							  $uuid = $3;
						  }
					  }
					  # if LINUXLIVE found return part-no,uuid
					  # else return partno = 0
					  print "$partno $uuid";' "$1")
	# return 0 on success, 10 otherse
	PARTNO=`echo "${PARTNOUUID}" | cut -d " " -f1`
	if test "${PARTNO}" -eq 0; then
		# LINUXLIVE not found
		echo "${PARTNOUUID}"
		return 10
	else
		# LINUXLIVE found
		echo "${PARTNOUUID}"
		return 0
	fi

}

#########################################################################
# function to install grub
# parameters passed: copy or nothing
# if copy is passed then cdrom is copied to LINUXLIVE
#########################################################################
installgrub () {
	# if copy given as first parameter
	# get device for grub install
	DEVICE=$(getdevice)
	# check for errors
	exitonerror "$?" "installgrub: getdevice could not find LINUXLIVE"
	echo "${EXTRAVERBOSE:+"getdevice returned device ${DEVICE}"}"
	

	# the device may be p1 LINUXLIVE vfat...
	# or                p1 EFILIVE ; p2 LINUXLIVE ...
	if test "$1" = "copy"; then
		# copy initialise-linux from local repository to /mnt/writable/upper/root/
		copyinitialise

		# get distro name from /mnt/cdrom/.disk/info
		# to be used by copygrub
		DISTRONAME=`getdistroname`;

		# echo distro name
		echo "${EXTRAVERBOSE:+"distro name: ${DISTRONAME}"}"

		# determine if p1 is EFILIVE or LINUXLIVE
		# and get the uuid
		# returned string is partition no , uuid
		# or 0 0  if it failed.
		PARTNOUUID=$(linuxlivedata "${DEVICE}")
		# check for errors
		exitonerror "$?" "linuxlivedata: Could not find the LINUXLIVE parition returuned PARTNOUUID = ${PARTNOUUID}"
		
		# for verbose

		# RESULT = partno uuid. separate them
		PARTNO=`echo ${PARTNOUUID} | cut -d " " -f1`
		UUID=`echo ${PARTNOUUID} | cut -d " " -f2`
		echo "${EXTRAVERBOSE:+"linuxlivedata returned partno = ${PARTNO}: uuid = ${UUID}"}"

		# if LINUXLIVE is partition 1 it is vfat
		# if LINUXLIVE is partition 2 it is ext4
		if test "${PARTNO}" -eq 1; then
			# LINUXLIVE is vfat
			# links cannot be copied to a fat32 filesystem

			# copy all cdrom files into LINUXLIVE
			# source appended by / so files are copied not containing directory
			copyfiles "/root/cdrom/" "/mnt/LINUXLIVE"

			# copy grub.cfg to /root/cdrom/boot/grub.cfg
			# set the uuid of the boot partition on the live system by reading it from the partition
			# uuid is different for vfat and ext4 LINUXLIVE partition.
			# determine the uuid of the partition
			# LINUXLIVE must be mounted
			mount ${VERBOSE:+"-v"} -L "LINUXLIVE" "/mnt/LINUXLIVE"
			exitonerror "$?" "installgrub: Error: Could not mount /mnt/LINUXLIVE"

			copygrub "LINUXLIVE" "${DISTRONAME}" "${UUID}"
			umountlabel "LINUXLIVE"

		elif test "${PARTNO}" -eq 2; then
			# LINUXLIVE is ext4
			#cdrom/EFI and cdrom/boot must be copied  to /mnt/EFILIVE

			# copy cdrom/EFI and cdrom/boot to /mnt/EFILIVE
			# source not appended by /, EFI and boot dirs must be copied
			copyfiles "/root/cdrom/EFI" "/mnt/EFILIVE"
			exitonerror $? "Error copying EFI to /mnt/EFILIVE" "/mnt/EFILIVE"
			copyfiles "/root/cdrom/boot" "/mnt/EFILIVE"
			exitonerror $? "Error copying boot to /mnt/EFILIVE" "/mnt/EFILIVE"

			mount ${VERBOSE:+"-v"} -L "EFILIVE" "/mnt/EFILIVE"
			exitonerror $? "Error could not mount /mnt/EFILIVE" "/mnt/EFILIVE"

			# copy grub.cfg to EFILIVE/boot/grub
			echo "${VERBOSE:+"installgrub: Calling copygrub EFILIVE ${DISTRONAME} ${UUID}"}"
			copygrub "EFILIVE" "${DISTRONAME}" "${UUID}"

			#umount EFILIVE
			umountlabel "EFILIVE"

			# copy cdrom files excluding cdrom/EFI and cdrom/boot  to LINUXLIVE.
			# EFI and boot reside on EFILIVE
			# do not copy /root/cdrom/EFI and /root/cdrom/boot to LINUXLIVE
			# the exclude option is only for this case , copying to LINUXLIVE ext4.
			# source must be appended by / so parent dir not copied
			copyfiles "/root/cdrom/" "/mnt/LINUXLIVE" "exclude"
		fi
	fi

	# the LINUXLIVE DEVICE was found
	# install grub
	# TESTING
	echo "install-grub ${VERBOSE:+"-v"} on ${DEVICE}"
	
	# only install grub on amd64
	ARCH=`arch`
	if test "${ARCH}" = "x86_64"; then
		grub-install --uefi-secure-boot --no-floppy --removable --target=x86_64-efi "${DEVICE}"
		exitonerror $? "Error installing grub"
	else
		echo "Simulating grub-install on arm64"
	fi
}


################################################################
# function to get distro name from cdrom/.disk/info
# the name is used for grub.cfg
# parameters passed: none
# the global variable DISTRONAME is set
################################################################
getdistroname () {
	# get the long name
	# Ubuntu-Cinnamon 26.04 "Resolute Raccoon" - Release amd64 (20260423.1)
	# strip from ' - Release ...to end
	# replace each " with \"
	LIST=`cat /root/cdrom/.disk/info`;
	DISTRONAME=$(perl -e 'my $name = shift; $name =~ s/ - .*$//;
							$name =~ s/"//g;
							chomp($name);
							print "$name";' "${LIST}");

	echo "${DISTRONAME}"
}

# function to backup grub.cfg to /root/cdrom/boot/grub/grub.cfg
# create grub.cfg on boot partition /mnt/LABEL/boot/grub/grub.cfg
# parameters passed: 1 LABEL of partition, EFILIVE or LINUXLIVE
#                    2 Flavour name version "Distro Name"
#                    3 UUID of boot partition on the live system
# name is obtained from cdrom/.disk/info
# this function works for both LINUXLIVE or EFILIVE
copygrub() {
	# backup original grub
	# EFILIVE or LINUXLIVE must be mounted.
	# boot directory must have been copied
	mv ${VERBOSE:+"-v"} "/mnt/$1/boot/grub/grub.cfg" "/mnt/$1/boot/grub/grub.cfg.original"
	exitonerror $? "Error moving grub.cfg to grub.cfg.original"

	# create /mnt/LABEL/boot/grub/grub.cfg
echo "set timeout=30

loadfont unicode

set menu_color_normal=white/blue
set menu_color_highlight=red/white

menuentry \"Try $2\" {
    set gfxpayload=keep

	insmod part_gpt
	insmod fat
	insmod ext2
	search --no-floppy --fs-uuid --set=root $3

    linux  /casper/vmlinuz  --- username=robert hostname=live persistent persistent-path=/casper/ noprompt vt.cur_default=8
    initrd /casper/initrd
}
menuentry \"$2 (safe graphics)\" {
    set gfxpayload=keep

	insmod part_gpt
	insmod fat
	insmod ext2
	search --no-floppy --fs-uuid --set=root $3
    linux  /casper/vmlinuz nomodeset  --- quiet splash
    initrd /casper/initrd
}
menuentry \"Macrium Reflect rescue \" {
	insmod part_gpt
	insmod fat
	if [ x\$feature_platform_search_hint = xy ]; then
	  search --no-floppy --fs-uuid --set=root  AED6-434E
	else
	  search --no-floppy --fs-uuid --set=root AED6-434E
	fi
	chainloader /bootmgfw.efi
	#chainloader /EFI/Boot/bootx64.efi
}
menuentry \"Windows Media Creation Tool Recovery (Read the instructions on the next screen)\" {
	echo \"You can use shift F10 for an administrator console\"
	echo \"install.esd is in sources directory\"
	echo \"You can hit escape to exit this message\"
	sleep -v -i 60

	insmod part_gpt
	insmod fat
	if [ x\$feature_platform_search_hint = xy ]; then
	  search --no-floppy --fs-uuid --set=root  4444-4444
	else
	  search --no-floppy --fs-uuid --set=root 4444-4444
	fi
	chainloader /bootmgfw.efi
}

grub_platform
if [ \"\$grub_platform\" = \"efi\" ]; then
menuentry 'Boot from next volume' {
    exit 1
}
menuentry 'UEFI Firmware Settings' {
    fwsetup
}
fi" > "/mnt/$1/boot/grub/grub.cfg"
}

##################################################################################
# function to copy MCTREC, MACRIUM and
# LINUXLIVE files to the hard disk. Partitions are mounted
# and unmounted.
# parameters passed 1. full source path, source must be appended by / so files are copied not directory
#                   2. destination root directory eg /mnt/EFILIVE/
#                   3. optional "exclude" exlude boot and EFI directories to LINUXLIVE
#                   form is: /mnt/LABEL/target_directory
##################################################################################
copyfiles () {
	# umounts device
	# mounts device
	# if /mnt/$2 contains files remove all files first
	# if $2 is LINUXLIVE also prompt to remove files from writable
	# copies files from $1 -> /mnt/$2
	# exits on any errors
	#
	# parameters passed:
	# 1 full source path
	# 2 label MACRIUM or MCTREC or LINUXLIVE/EFILIVE for file type
	# get the label
	# destination is of form /mnt/LABEL/target_directory
	LABEL=$(echo "$2" | cut -d "/" -f3)

	# mount LABEL if not already mounted
	umountlabel "${LABEL}"
	mount ${VERBOSE:+"-v"} -L "${LABEL}" "/mnt/${LABEL}"
	exitonerror "$?" "copyfiles: Could not mount ${LABEL} on /mnt/${LABEL}" "/mnt/${LABEL}"

	# make the directory if it does not exist
	test -d "$2" || mkdir -p ${VERBOSE:+"-v"} "$2"


	# print message
	echo "copying $1 -> $2"

	# try rsync for copying so directories can be excluded
	# rsync -zr cdrom/ /mnt/destination copies files in cdrom to destination
	# rsync -zr cdrom /mnt/destination copies to /mnt/destination/cdrom
	if test "${3}" = "exclude"; then
		# copying cdrom/ -> /mnt/LINUXLIVE (ext4)
		rsync -rz --no-links --mkpath --exclude='boot/' --exclude='EFI/' "${1}" "${2}"
	else
		# copying /root/cdrom/ /mnt/LINUXLIVE (vfat)
		rsync -rz --mkpath --no-links "${1}" "${2}"
	fi
#	cp -dR -T ${EXTRAVERBOSE:+"-v"} "$1" "$2"
	exitonerror $? "copyfiles: Could not copy $1 files to $2" "/mnt/${LABEL}"
	# umount device which must be in fstab
	echo "copyfiles: un mounting /mnt/${LABEL}"
	umountlabel "${LABEL}"
}


##################################################################
# function to format a list of partitions
# parameters passed: list of partitions to be formated
# the LINUXLIVE disk must be available.
# return status :  success = 0
#                  failure = non zero
#################################################################
formatpartitions() {
	# get the device of LINUXLIVE
echo "getting device"
	DEVICE=$(getdevice)	
	exitonerror "$?" "getdevice() returned an error"

	# the device is now DEVICE.
	# get the partition number from the label
	# $1 contains the list of partitions
	for label in $(echo "${1}"); do
		# get the partition number
		PARTN=$(getpnofromlabel "${DEVICE}" "${label}")
		exitonerror "$?" "formatpartitions: Could not fine partition ${label}"
		echo "formatpartitions: label ${label} on ${DEVICE}${PARTN}"
		
		# umount the partition
		umountlabel "${label}"
		
		# format the partion. The fs and uuid depend on the partition
		case "${label}" in
			"EFILIVE")   mkfs.vfat ${VERBOSE:+"-v"} -n "EFILIVE" "${DEVICE}${PARTN}";;
			"MACRIUM")   mkfs.vfat ${VERBOSE:+"-v"} -n "MACRIUM" -i "${MACRIUMUUID}" "${DEVICE}${PARTN}";;
			"MCTREC")    mkfs.vfat ${VERBOSE:+"-v"} -n "MCTREC" -i "${MCTRECUUID}" "${DEVICE}${PARTN}";;
			"data")      mkfs.ntfs ${VERBOSE:+"-v"} -L "data" -Q "${DEVICE}${PARTN}";;
			"writable")  mkfs.ext4 ${VERBOSE:+"-v"} -L "writable" -j -F "${DEVICE}${PARTN}";;
			"LINUXLIVE") 	# partition 1 will be vfat with uuid
							# partition 2 will be ext4 with uud
							if test "${PARTN}" -eq 2; then
								# ext4
								# use UUID if it was given on the command line
								# else use the default LINUXLIVEUUID
								if test "${UUID}" = "0"; then
									# no uuid given use default
									mkfs.ext4 -j -L LINUXLIVE ${VERBOSE:+"-v"} -F -U "${LINUXLIVEUUID}" "${DEVICE}${PARTN}"
									exitonerror "$?" "formatpartitions: Error formatting ${label} ${DEVICE}${PARTN}"
								else
									# use the given UUID
									mkfs.ext4 -j -L LINUXLIVE ${VERBOSE:+"-v"} -F -U "${UUID}" "${DEVICE}${PARTN}"
									exitonerror "$?" "formatpartitions: Error formatting ${label} ${DEVICE}${PARTN}"
								fi
							elif test "${PARTN}" -eq 1; then
								# vfat
								# use UUID if it was given on the command line
								# else use the default LINUXLIVEUUID
								if test "${UUID}" = "0"; then
									# no uuid given use default
									mkfs.vfat -n LINUXLIVE ${VERBOSE:+"-v"} -i "${LINUXLIVEVOLID}" "${DEVICE}${PARTN}"
									exitonerror "$?" "formatpartitions: Error formatting ${label} ${DEVICE}${PARTN}"
								else
									# use the given UUID
									mkfs.vfat -n LINUXLIVE ${VERBOSE:+"-v"} -i "${UUID}" "${DEVICE}${PARTN}"
									exitonerror "$?" "formatpartitions: Error formatting ${label} ${DEVICE}${PARTN}"
								fi
							else
								# the partition no is not 1 or 2.
								# this is an error
								exitonerror 1 "formatpartitions: LINUXLIVE partition no is not 1 or 2: ${PARTN}"
							fi;;
			*)        exitonerror 1 "formatpartitions: ${label} is an unknown partition";;
		esac
	done
}
##################################################################
# function to mount cdrom, copy files
# to /root/cdrom and set the file permissions
# so that cp -T can be used for each partition
# parameters passed: isoimage name
##################################################################
mountcopypermissions() {
	# make /mnt/cdrom if it does not exist
	test -d /mnt/cdrom || mkdir /mnt/cdrom

	# mount the cdrom
	# umount it first if mounted
	# since the wrong one may be mounted
	findmnt /mnt/cdrom > /dev/null 2>&1
	if test "$?" -eq 0; then
		umount ${VERBOSE:+"-v"} "/mnt/cdrom"
		exitonerror $? "Error umounting $1"
	fi

	# mount the cdrom
	mount ${VERBOSE:+"-v"} "$1" /mnt/cdrom -o ro
	exitonerror $? "Could not mount $1 on /mnt/cdrom" "/mnt/cdrom"

	# if /root/cdrom exists
	# delete it
	test -d /root/cdrom && rm ${EXTRAVERBOSE:+"-v"} -rf /root/cdrom

	# copy cdrom files to root
	echo "copying /mnt/cdrom -> /root"
	cp -dR ${EXTRAVERBOSE:+"-v"} /mnt/cdrom /root/
	exitonerror $? "Error copying files from /mnt/cdrom to /root/cdrom" "/mnt/cdrom"

	# set file and directory permissions
	find /root/cdrom -type f -exec chmod a+w {} \;
	find /root/cdrom -type d -exec chmod 755 {} \;

	umount ${VERBOSE:+"-v"} "/mnt/cdrom"
	exitonerror $? "Could not umount iso image $1 from /mnt/cdrom"

	# delete all links, they cannot be copied to a vfat fs.
	find "/root/cdrom" -type l -exec rm ${VERBOSE:+"-v"} {} \;
}

# usage function
usage() {
	echo "-c isoimage : create /root/cdrom with iso image";
	echo "-i install grub and copy cdrom files to LINUXLIVE and copy initialise-linux to /mnt/writable/upper/root/"
	echo "-I install grub only"
	echo "-F [\"label1 label2 ..\"] format the partitions from the list -e or -f override -F"
	echo "-U uuid / volume id of LINUXLIVE partition"
	echo "	ext4 default ${LINUXLIVEUUID}"
	echo "	vfat default ${LINUXLIVEVOLID}"
	echo "-m copy MACRIUM files to MACRIUM partition";
	echo "-t copy MCTREC files to MCTREC partition";
	echo "-e partition disk LINUXLIVE as ext4, separate from EFI partition";
	echo "-f partition disk LINUXLIVE as fat32. combined with EFI parttion";
	echo "-E size in GB of EFILIVE partition, default = ${EFISIZE}GB";
	echo "-M size in GB of MACRIUM parition, default = ${MASIZE}GB";
	echo "-L size in GB of LINUXLIVE partition, default = ${LLIVESIZE}GB";
	echo "-W size in GB of writable partition, default = ${WSIZE}GB";
	echo "-T size in GB of MCTREC partition, default = ${MCTSIZE}GB";
	echo "-v verbose for everything except file copy/move"
	echo "-V verbose for everything"
	exit 0;
}

#################################################################
# main entry
#################################################################

# set partition disk to false, unless -p or -D or -W or -M passed
PARTDISK="false"
# default values for partdisk.pl in GB
EFISIZE=2;
LLIVESIZE=8;
WSIZE=10;
MCTSIZE=8;
MASIZE=2;
FLIST=""

# default values for switches
FORMAT="false"
ISOIMAGE="none"
CPMACRIUM="false"
CPMCTREC="false"
INSTALLGRUB="false"
INSTALLGRUBCOPY="false"
VFATOPTION="false"
EXT4OPTION="false"
UUID="0"

# VERBOSE must not be set for absence of -v
# if it is set to anything, -v will be used
VERBOSE=
# EXTRAVERBOSE is used to display verbose for copying of files as well"
EXTRAVERBOSE=

# uuid of LINUXLIVE parition p2.
LINUXLIVEUUID="12345678-1234-1234-1234-123456789012"

#volume id for LINUXLIVE partition p1
LINUXLIVEVOLID="11111111"

# uuid for macrium
MACRIUMUUID=AED6434E

# uuid for MCTREC
MCTRECUUID=44444444

# source path for MACRIUM and MCTREC files.
MSOURCE="/mnt/debhome/livesystem"

while getopts F:efiU:Ic:D:W:M:L:T:mtvVh opt
do
	case ${opt} in
		F) FORMAT="true"; FLIST="${OPTARG}";;
		f) VFATOPTION="true"; PARTDISK="true";;
		e) EXT4OPTION="true"; PARTDISK="true";;
		I) INSTALLGRUB="true";;
		U) UUID="${OPTARG}";;
		E) EFISIZE="${OPTARG}";;
		i) INSTALLGRUBCOPY="true";;
		c) ISOIMAGE="${OPTARG}";;
		M) MASIZE="${OPTARG}"; PARTDISK="true";;
		L) LLIVESIZE="${OPTARG}"; PARTDISK="true";;
		W) WSIZE="${OPTARG}"; PARTDISK="true";;
		T) MCTSIZE="${OPTARG}"; PARTDISK="true";;
		m) CPMACRIUM="true";;
		t) CPMCTREC="true";;
		v) VERBOSE="true";;
		V) EXTRAVERBOSE="true"; VERBOSE="true";;
		h) usage;;
		\?) usage;;
	esac
done

#########################################################################
# for testing, until the exit
#######################################################################

########################################################################
# end of testing
########################################################################

# if -p or -D or -W or -M or -e or -f given , partition the disk
# for partitioning one of -e or -f must be given.
if test "${PARTDISK}" = "true"; then
	# if -F given to format set it to false
	if test "${FORMAT}" = "true"; then
		FORMAT="false"
		# echo an error message
		echo "-e and -f override -F"
	fi

	# check if -e given
	if test "${EXT4OPTION}" = "true"; then
		# partition with ext4 option
		# set the uuid to default if it was not given
		test "${UUID}" = "0" && UUID="${LINUXLIVEUUID}"

		/usr/local/bin/partdisk.pl ${VERBOSE:+"-v"} -e -E "${EFISIZE}" -U "${UUID}" -L "${LLIVESIZE}" -W "${WSIZE}" -M "${MASIZE}" -T "${MCTSIZE}"
		exitonerror $? "partdisk.pl gave an error ... exiting"
	elif test "${VFATOPTION}" = "true"; then
		# parition with vfat option
		# set the uuid to default if it was not given
		test "${UUID}" = "0" && UUID="${LINUXLIVEVOLID}"

		/usr/local/bin/partdisk.pl ${VERBOSE:+"-v"} -f -U "${UUID}" -L "${LLIVESIZE}" -W "${WSIZE}" -M "${MASIZE}" -T "${MCTSIZE}"
		exitonerror $? "partdisk.pl gave an error ... exiting"
	else
		# neither -e nor -f was given
		echo "Neither -e nor -f was given: cannot partition the disk"
	fi
fi

# format the partitions if necessary
if test "${FORMAT}" = "true"; then
	# Flist contains the list of labels.
	# the disk with LINUXLIVE must be available
	formatpartitions "${FLIST}"
fi

# if -c given, create /root/cdrom else /root/cdrom must already exist
if test "${ISOIMAGE}" != "none"; then
	# check iso image exists
	test -f "${ISOIMAGE}" || exitonerror 1 "${ISOIMAGE}: no such file";

	# mount the cdrom for coyping files to /root/cdrom
	# check if /root/cdrom exists
	# mount , copy, set permissions
	mountcopypermissions "${ISOIMAGE}"

fi

# copy files for MACRIUM if -m given
test "${CPMACRIUM}" = "true" && copyfiles "${MSOURCE}/MACRIUM/" "/mnt/MACRIUM"

# for mctrec if -t given
test "${CPMCTREC}" = "true" && copyfiles "${MSOURCE}/MCTREC/" "/mnt/MCTREC"

# install grub to the correct device
# -i install and copies cdrom  EFI files
# -I install grub only
# -i takes precedence over -I
# device is in /root/.device which was written by partdisk.pl
# get the device, if device not found, none is returned
if test "${INSTALLGRUBCOPY}" = "true"; then
	installgrub "copy"
elif test "${INSTALLGRUB}" = "true"; then
	# -I given, install grub only
	installgrub
fi
